---
// The landing page is an inbox: each section is a letter from the author. Clearing them all leads to "ozero" and the waitlist.
import '../../styles/fonts.css';
import '../../styles/site.css';
import Mark from '../../components/Mark.astro';
import Letter from '../../components/Letter.astro';
import Grid from '../../components/Grid.astro';
import { LANGS, strings, type Lang } from '../../i18n';
import { fill, plural } from '../../i18n/format';
import { CONTACT, INDEXABLE, STATS_URL, STORES, TIPS } from '../../config';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = strings[lang];
const c = t.client;
const tip = TIPS[lang];

const letters = [
  { id: 'm1', color: 'var(--acc-4)', tag: t.tag1, when: '09:41', subject: t.s1 },
  { id: 'm2', color: 'var(--acc-1)', tag: t.tag2, when: '09:38', subject: t.s2 },
  { id: 'm3', color: 'var(--acc-2)', tag: t.tag3, when: '09:30', subject: t.s3 },
  { id: 'm4', color: 'var(--acc-3)', tag: t.tag7, when: t.tYest, subject: t.s7 },
  { id: 'm5', color: 'var(--acc-3)', tag: t.tag4, when: t.tYest, subject: t.s4 },
  { id: 'm6', color: 'var(--accent)', tag: t.tag5, when: t.tYest, subject: t.s5 },
  { id: 'm7', color: 'var(--fg-3)', tag: t.tag6, when: t.tNow, subject: t.s6 },
];
const [m1, m2, m3, m4, m5, m6, m7] = letters;
const n = letters.length;

const stores = [
  { key: 'appStore', url: STORES.appStore, small: t.storeApple, big: 'App Store', icon: 'M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9s-1.9-.9-3.1-.8C6.8 7.4 5.3 8.3 4.5 9.8c-1.7 2.9-.4 7.2 1.2 9.5.8 1.1 1.7 2.4 2.9 2.4 1.2-.1 1.6-.8 3-.8s1.8.8 3.1.7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.3-2.6 1.3-2.6s-2.4-1-2.4-4.1zM14.1 5.7c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.5 2.8-1.3z' },
  { key: 'googlePlay', url: STORES.googlePlay, small: t.storeGoogle, big: 'Google Play', icon: 'M4 2.8v18.4c0 .4.4.6.7.4l10.6-9.2L4.7 2.4c-.3-.2-.7 0-.7.4zM16.6 13.5l2.8 1.6c.8.5.8 1.5 0 2l-.1.1-2.7-2.4zM16.6 10.5l2.7-2.4.1.1c.8.5.8 1.5 0 2zM15.4 11.4 5.9 3l9.5 5.5zM15.4 12.6 5.9 21l9.5-5.5z' },
].filter((s) => s.url);

const shot = [
  { c: 'var(--acc-2)', who: t.sh1w, acc: t.aWork, when: '14:05', subj: t.sh1s, unread: true },
  { c: 'var(--acc-4)', who: t.sh2w, acc: t.aStudio, when: '13:18', subj: t.sh2s, unread: true },
  { c: 'var(--acc-3)', who: t.sh3w, acc: 'iCloud', when: '11:30', subj: t.sh3s },
  { c: 'var(--acc-1)', who: t.sh4w, acc: t.aPersonal, when: t.tYest, subj: t.sh4s },
];
const lastQuestion = t.questions.length - 1;
const site = Astro.site;
const url = new URL(`/${lang}/`, site);
const mailto = (os: string) =>
  `mailto:${CONTACT}?subject=${encodeURIComponent(t.cSubj)}&body=${encodeURIComponent(`${t.cText}\n\n${fill(c.phone, { os })}`)}`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{t.title}</title>
  <meta name="description" content={t.description}>
  {!INDEXABLE && <meta name="robots" content="noindex, nofollow">}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, site)}>)}
  <link rel="alternate" hreflang="x-default" href={new URL('/en/', site)}>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Ozero Mail">
  <meta property="og:title" content={t.h1}>
  <meta property="og:description" content={t.sub}>
  <meta property="og:url" content={url}>
  <meta property="og:locale" content={t.ogLocale}>
  <meta property="og:image" content={new URL(`/og-${lang}.png`, site)}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <noscript><style>.tip,.mfoot,.bulk,.bbar .prog{display:none}</style></noscript>
  <meta name="color-scheme" content="light dark">
</head>
<body>
<a class="skip" href="#m1">{t.skip}</a>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</svg>

<div class="lake" id="lake" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
<div class="app" id="app">
  <aside class="side" aria-label={t.listLabel}>
    <span class="brand"><Mark id="mk1" />ozero mail</span>
    <ol id="sidelist">
      {letters.map((l) => (
        <li><a href={`#${l.id}`} style={`--c:${l.color}`}><span class="s-from">{l.tag}</span><span class="s-t">{l.when}</span><span class="s-subj">{l.subject}</span></a></li>
      ))}
    </ol>
    <span class="meta">Android · iOS · Gmail · Outlook · iCloud · IMAP</span>
  </aside>

  <main>
    <header class="head">
      <span class="mobile-brand"><Mark id="mk2" />ozero mail</span>
      <p class="inboxline"><span>{t.inbox}</span><span class="n" id="count">{n}</span><span class="sr" id="unreadSr"> {plural(lang, c.unread, n)}</span></p>
      <h1>{t.h1}</h1>
      <p class="sub">{t.sub}</p>
      {stores.length > 0 && (
        <div class="stores">
          {stores.map((s) => (
            <a class="store" data-store={s.key} href={s.url} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.icon}/></svg>
              <span><small>{s.small}</small><b>{s.big}</b></span>
            </a>
          ))}
        </div>
      )}
      <p class="tip"><span class="touch">{t.tip}</span><span class="mouse">{t.tipMouse}</span></p>
    </header>

    <Letter t={t} {...m1}>
      <Fragment slot="from">{t.name}<span class="role">{t.role}</span></Fragment>
      <div class="mbody">
        <p>{t.m1a}</p>
        <p>{t.m1b}</p>
        <div class="links"><a href="https://khizrim.ru" target="_blank" rel="noopener">khizrim.ru</a><a href="https://github.com/khizrim" target="_blank" rel="noopener">GitHub</a></div>
      </div>
    </Letter>

    <Letter t={t} {...m2}>
      <div class="mbody">
        <div class="stamp" role="img" aria-label={t.aiFree}><s>AI</s><br>FREE</div>
        <ul class="checks">
          {t.privacy.map((s) => <li><svg><use href="#i-check"/></svg><span>{s}</span></li>)}
        </ul>
      </div>
    </Letter>

    <Letter t={t} {...m3} pill={t.wipPill}>
      <div class="mbody">
        <div class="shot" role="img" aria-label={t.shotLabel}>
          <div class="top"><strong>{t.shInbox}</strong><span>{t.shAll}</span></div>
          {shot.map((r) => (
            <div class:list={['r', { u: r.unread }]} style={`--rc:${r.c}`}><div class="l1"><b>{r.who}</b><small>{r.acc}</small><small>{r.when}</small></div><div class="s">{r.subj}</div></div>
          ))}
          <div class="tabs"><span class="on">{t.tbPeople}</span><span>{t.tbServices}</span><span>{t.tbNews}</span></div>
          <div class="bar"><span>{t.shSearch}</span><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16z"/></svg></span></div>
        </div>
        <Grid items={t.features} color="var(--acc-2)" />
        <p class="note">{t.wipText}</p>
      </div>
    </Letter>

    <Letter t={t} {...m4}>
      <div class="mbody"><Grid items={t.comparison} color="var(--acc-3)" /></div>
    </Letter>

    <Letter t={t} {...m5}>
      <div class="mbody"><Grid items={t.promises} color="var(--acc-3)" /></div>
    </Letter>

    <Letter t={t} {...m6}>
      <div class="mbody">
        <div class="receipt">
          {t.receiptFree.map((s) => <div class="ln"><span>{s}</span><b>{t.free}</b></div>)}
          <div class="sep"></div>
          <div class="ln"><span>{t.rc4}</span><b>{t.pricePro}</b></div>
          <div class="ln muted"><span>{t.rc5}</span><b>{t.none}</b></div>
          <div class="sep"></div>
          <div class="ln sum"><span>{t.rc6}</span><b>{t.priceFree}</b></div>
        </div>
        <p class="note">{t.proNote}</p>
        {tip && <p class="note"><span>{t.tipText}</span> <a href={tip} target="_blank" rel="noopener">{t.tipLink}</a></p>}
      </div>
    </Letter>

    <Letter t={t} {...m7} ava="?">
      <div class="thread">
        {t.questions.map(({ q, a }, i) => (
          <>
            <div class="bubble"><span class="ava you" aria-hidden="true">?</span><p class="txt"><span class="who">{t.you}</span><span>{q}</span></p></div>
            <div class="bubble me"><span class="ava" aria-hidden="true">{t.avaL}</span><p class="txt"><span>{a}</span>
              {i === lastQuestion && <span class="steps">{t.roadmap.map((s, k) => <span class:list={{ now: k === t.roadmapNow }}>{s}</span>)}</span>}
            </p></div>
          </>
        ))}
      </div>
    </Letter>

    <section class="finale" id="finale">
      <div class="oz" aria-hidden="true"><span class="w" id="ozw">{c.word}</span><span class="n" id="ozn">{n}</span></div>
      <p id="finaleText" tabindex="-1">{c.fin}</p>
      <div class="bulk" id="bulk"><div class="under" aria-hidden="true"><svg width="18" height="18"><use href="#i-check"/></svg><span>{t.doneLbl}</span></div><button type="button" class="bs" id="bulkBtn" aria-label={fill(c.bulkLabel, { n })}><span class="grip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span><span id="bulkText">{plural(lang, c.bulk, n)}</span><span class="grip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span></button></div>
      <button type="button" id="bringBack" hidden>{t.bringBack}</button>
    </section>

    <section class="compose" id="wait" aria-labelledby="waitTitle">
      <div class="field"><span class="lbl">{t.fTo}</span><span>{t.name}</span></div>
      <fieldset class="field"><legend class="lbl">{t.fPhone}</legend>
        <div class="seg">
          <label><input type="radio" name="os" value="iPhone" checked><span>iPhone</span></label>
          <label><input type="radio" name="os" value="Android"><span>Android</span></label>
        </div>
      </fieldset>
      <div class="field"><span class="lbl">{t.fSubj}</span><h2 id="waitTitle">{t.cSubj}</h2></div>
      <p class="text">{t.cText}</p>
      <div class="send"><span class="fine">{t.cFine}</span><a class="sendbtn" id="send" href={mailto('iPhone')} data-href={mailto('{os}')}><span>{t.sendLabel}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></a></div>
    </section>

    <footer>
      <span>Ozero Mail</span>
      <span>{t.foot1}</span>
      {STATS_URL && <span><span>{t.statsText}</span> <a href={STATS_URL} target="_blank" rel="noopener">{t.statsLink}</a></span>}
      <span><span>{t.foot2}</span> · <a href="https://khizrim.ru" target="_blank" rel="noopener">khizrim.ru</a>{tip && <> · <a href={tip} target="_blank" rel="noopener">{t.tipFoot}</a></>}</span>
    </footer>
  </main>
</div>

<nav class="bbar" aria-label={t.barLabel}>
  <div class="cap">
    <div class="prog"><b id="left">{fill(c.left, { n })}</b><span class="track" role="progressbar" aria-valuemin="0" aria-valuemax={n} aria-valuenow="0" id="track" aria-label={t.progLabel}><i id="bar"></i></span></div>
    <div class="lang" role="group" aria-label={t.langLabel}>
      {LANGS.map((l) => <a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>)}
    </div>
    {stores.length > 0
      ? <a class="cta" id="cta" href={stores[0].url} target="_blank" rel="noopener">{t.getApp}</a>
      : <a class="cta" id="cta" href="#wait">{t.cta}</a>}
  </div>
</nav>
<p class="sr" id="live" aria-live="polite"></p>
<div class="toast" id="toast" hidden><span id="toastText"></span><button type="button" id="toastUndo">{t.undo}</button></div>

<script type="application/json" id="strings" set:html={JSON.stringify({ lang, done: t.doneLbl, cta: t.cta, ...c }).replace(/</g, '\\u003c')} />
<script>
  import { start } from '../../scripts/inbox';
  start();
</script>
</body>
</html>
