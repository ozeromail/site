---
// The page is a short inbox: a letter per pain, then one from the author, with plenty of air. Clearing them leads to "ozero" and a note to the author.
import '../../styles/fonts.css';
import '../../styles/site.css';
import Part from '../../components/Part.astro';
import Demo from '../../components/Demo.astro';
import { LANGS, strings, type Lang } from '../../i18n';
import { fill } from '../../i18n/format';
import { CONTACT, INDEXABLE, STATS_URL, STORES, TIPS } from '../../config';
import interLatin from '@fontsource-variable/inter/files/inter-latin-standard-normal.woff2?url';
import interCyrillic from '@fontsource-variable/inter/files/inter-cyrillic-standard-normal.woff2?url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = strings[lang];
const tip = TIPS[lang];
const mailto = (os: string) =>
  `mailto:${CONTACT}?subject=${encodeURIComponent(t.mailSubj)}&body=${encodeURIComponent(`${t.mailBody}\n\n${fill(t.cPhone, { os })}`)}`;

const stores = [
  { key: 'appStore', url: STORES.appStore, small: t.storeApple, big: 'App Store' },
  { key: 'googlePlay', url: STORES.googlePlay, small: t.storeGoogle, big: 'Google Play' },
].filter((s) => s.url);
const released = stores.length > 0;

const site = Astro.site;
const url = new URL(`/${lang}/`, site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{t.title}</title>
  <meta name="description" content={t.description}>
  {!INDEXABLE && <meta name="robots" content="noindex, nofollow">}
  {(lang === 'ru' ? [interLatin, interCyrillic] : [interLatin]).map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin>)}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, site)}>)}
  <link rel="alternate" hreflang="x-default" href={new URL('/en/', site)}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Ozero Mail">
  <meta property="og:title" content={t.h1}>
  <meta property="og:description" content={t.sub}>
  <meta property="og:url" content={url}>
  <meta property="og:locale" content={t.ogLocale}>
  <meta property="og:image" content={new URL(`/og-${lang}.png`, site)}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="color-scheme" content="light dark">
  <noscript><style>html .finale .calm,html .finale .next{opacity:1}</style></noscript>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-sent" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V4.5M6 10.5l6-6 6 6"/></g></symbol>
  <symbol id="i-archive" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="4.5" rx="1.2"/><path d="M5 8.5V18a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 19 18V8.5"/><path d="M10 12.5h4"/></g></symbol>
  <symbol id="i-maybe" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14"/><circle cx="12" cy="17.6" r="1.15" fill="currentColor" stroke="none"/></g></symbol>
  <symbol id="i-close" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></g></symbol>
  <symbol id="i-spam" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.3 3h7.4L21 8.3v7.4L15.7 21H8.3L3 15.7V8.3z"/><path d="M12 7.5V13"/><circle cx="12" cy="16.6" r="1.15" fill="currentColor" stroke="none"/></g></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5h16"/><path d="M9 6.5V4h6v2.5"/><path d="M6 6.5 7 19a1.5 1.5 0 0 0 1.5 1.4h7A1.5 1.5 0 0 0 17 19l1-12.5"/><path d="M10 10.5v6M14 10.5v6"/></g></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></g></symbol>
  <symbol id="i-compose" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19.2 8.8a2.8 2.8 0 0 0-4-4L4 16z"/><path d="m13.5 6.5 4 4"/></g></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.5 9.5 17.5 19.5 7"/></g></symbol>
</svg>

<main id="app">
  <header class="top">
    <picture class="brand">
      <source srcset={`/brand/ozero-mail${lang === 'ru' ? '-ru' : ''}-lockup-dark.svg`} media="(prefers-color-scheme: dark)">
      <img src={`/brand/ozero-mail${lang === 'ru' ? '-ru' : ''}-lockup-light.svg`} alt="Ozero Mail" height="28">
    </picture>
    <nav class="lang" aria-label={t.langLabel}>
      {LANGS.map((l) => <a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>)}
    </nav>
  </header>

  <section class="head">
    <h1>{t.h1}</h1>
    <p class="sub">{t.sub}</p>
    {released && (
      <div class="stores">{stores.map((s) => <a class="store" href={s.url} target="_blank" rel="noopener"><small>{s.small}</small><b>{s.big}</b></a>)}</div>
    )}
    <a class="tip" href="#first">{t.more}<span class="drift" aria-hidden="true">↓</span></a>
  </section>

  {t.pains.map((p, i) => (
    <Part id={i === 0 ? 'first' : undefined} title={p.q}><p>{p.a}</p><Demo t={t} kind={p.demo} /></Part>
  ))}
  <Part title={t.plan.q}>
    <p>{t.plan.a}</p>
    <ol class="plan">{t.plan.steps.map((step, i) => <li class={i < t.plan.now ? 'done' : i === t.plan.now ? 'now' : undefined} aria-current={i === t.plan.now ? 'step' : undefined}>{step}{i < t.plan.now && <span class="sr">, {t.plan.doneLbl}</span>}{i === t.plan.now && <> <span class="pill">{t.plan.nowLbl}</span></>}</li>)}</ol>
  </Part>

  <section class="finale" id="finale">
    <div class="oz" aria-hidden="true">{t.ozero}</div>
    <canvas class="lake" id="lake" aria-hidden="true"></canvas>
    <p class="calm">{t.calm}</p>
    {!released && <a class="next" href="#wait">{t.next}<span class="drift" aria-hidden="true">↓</span></a>}
  </section>

  {!released && (
    <section class="wait" id="wait" aria-labelledby="waitTitle">
      <p class="soon">{t.soon}</p>
      <div class="compose">
        <div class="field"><span class="lbl">{t.fTo}</span><span>{t.name}</span></div>
        <div class="field"><span class="lbl" id="osLbl">{t.fOs}</span>
          <div class="seg" role="radiogroup" aria-labelledby="osLbl">
            <label><input type="radio" name="os" value="android" checked><span>Android</span></label>
            <label><input type="radio" name="os" value="iphone"><span>iPhone</span></label>
          </div>
        </div>
        <div class="field"><span class="lbl">{t.fSubj}</span><h2 id="waitTitle">{t.mailSubj}</h2></div>
        <p class="text">{t.mailBody}</p>
        <div class="send"><span class="fine">{t.cFine}</span><a class="btn" id="send" href={mailto('Android')} data-iphone={mailto('iPhone')} data-android={mailto('Android')}>{t.send}</a></div>
      </div>
    </section>
  )}

  <footer>
    <span><span>{t.by}</span> · <a href="https://khizrim.ru" target="_blank" rel="noopener">khizrim.ru</a></span>
    {STATS_URL && <span><span>{t.statsText}</span> <a href={STATS_URL} target="_blank" rel="noopener">{t.statsLink}</a></span>}
    {tip && <a href={tip} target="_blank" rel="noopener">{t.tipFoot}</a>}
    <a href={`/${lang}/privacy/`}>{t.privacyLink}</a>
  </footer>
</main>

{!released && <nav class="bbar" aria-label={t.barLabel}><a class="btn" href="#wait">{t.cta}</a></nav>}
<script>
  import { start } from '../../scripts/inbox';
  start();
</script>
</body>
</html>
