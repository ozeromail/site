---
// The privacy policy: what the app and the site do with data. Plain text, one column.
import '../../styles/fonts.css';
import '../../styles/site.css';
import { LANGS, strings, type Lang } from '../../i18n';
import { fill } from '../../i18n/format';
import { CONTACT, INDEXABLE } from '../../config';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const p = strings[lang].privacy;
const site = Astro.site;

// Text with [links](url) in it, as plain parts and links.
const parts = (text: string) =>
  fill(text, { email: CONTACT })
    .split(/\[([^\]]+)\]\(([^)]+)\)/)
    .map((s, i, all) => (i % 3 === 0 ? { text: s } : i % 3 === 1 ? { text: s, href: all[i + 1] } : null))
    .filter((part) => part !== null);
---
<!doctype html>
<html lang={lang} class="doc">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{p.title}</title>
  <meta name="description" content={p.description}>
  {!INDEXABLE && <meta name="robots" content="noindex, nofollow">}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/privacy/`, site)}>)}
  <link rel="alternate" hreflang="x-default" href={new URL('/en/privacy/', site)}>
  <meta name="color-scheme" content="light dark">
</head>
<body>
<main class="policy">
  <p class="home"><a href={`/${lang}/`}>{p.home}</a></p>
  <h1>{p.h1}</h1>
  <p class="date">{p.updated}</p>
  <p class="lead">{p.lead}</p>
  {p.sections.map((s) => (
    <section>
      <h2>{s.h}</h2>
      {s.p.map((text) => (
        <p>{parts(text).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</p>
      ))}
    </section>
  ))}
  <p class="other">{LANGS.filter((l) => l !== lang).map((l) => <a href={`/${l}/privacy/`} lang={l}>{strings[l].privacy.h1}</a>)}</p>
</main>
</body>
</html>
