---
// The page is a short inbox: a letter per pain, then one from the author, with plenty of air. Clearing them leads to "ozero" and a note to the author.
import '../../styles/fonts.css';
import '../../styles/site.css';
import Mark from '../../components/Mark.astro';
import Letter from '../../components/Letter.astro';
import { LANGS, strings, type Lang } from '../../i18n';
import { fill, plural } from '../../i18n/format';
import { CONTACT, INDEXABLE, STATS_URL, STORES, TIPS } from '../../config';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = strings[lang];
const c = t.client;
const tip = TIPS[lang];
const n = t.pains.length + 1;
const mailto = (os: string) =>
  `mailto:${CONTACT}?subject=${encodeURIComponent(t.mailSubj)}&body=${encodeURIComponent(`${t.mailBody}\n\n${fill(t.cPhone, { os })}`)}`;

const stores = [
  { key: 'appStore', url: STORES.appStore, small: t.storeApple, big: 'App Store' },
  { key: 'googlePlay', url: STORES.googlePlay, small: t.storeGoogle, big: 'Google Play' },
].filter((s) => s.url);
const released = stores.length > 0;

const site = Astro.site;
const url = new URL(`/${lang}/`, site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{t.title}</title>
  <meta name="description" content={t.description}>
  {!INDEXABLE && <meta name="robots" content="noindex, nofollow">}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, site)}>)}
  <link rel="alternate" hreflang="x-default" href={new URL('/en/', site)}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Ozero Mail">
  <meta property="og:title" content={t.h1}>
  <meta property="og:description" content={t.sub}>
  <meta property="og:url" content={url}>
  <meta property="og:locale" content={t.ogLocale}>
  <meta property="og:image" content={new URL(`/og-${lang}.png`, site)}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="color-scheme" content="light dark">
  <noscript><style>.act,.tip,.bulk,.bbar{display:none}</style></noscript>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</svg>

<div class="lake" id="lake" aria-hidden="true"><i></i><i></i><i></i></div>
<main id="app">
  <header class="top">
    <span class="brand"><Mark id="mk" />ozero mail</span>
    <nav class="lang" aria-label={t.langLabel}>
      {LANGS.map((l) => <a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>)}
    </nav>
  </header>

  <section class="head screen">
    <p class="inboxline"><span>{t.inbox}</span><span class="n" id="count">{n}</span><span class="sr" id="unreadSr"> {plural(lang, c.unread, n)}</span></p>
    <h1>{t.h1}</h1>
    <p class="sub">{t.sub}</p>
    {released && (
      <div class="stores">{stores.map((s) => <a class="store" href={s.url} target="_blank" rel="noopener"><small>{s.small}</small><b>{s.big}</b></a>)}</div>
    )}
    <a class="tip" href="#first"><span class="touch">{t.tip}</span><span class="mouse">{t.tipMouse}</span><span class="drift" aria-hidden="true">↓</span></a>
  </section>

  {t.pains.map((p, i) => (
    <Letter t={t} id={i === 0 ? 'first' : undefined} subject={p.q} from={p.from} when={p.when}><p>{p.a}</p></Letter>
  ))}
  <Letter t={t} subject={t.plan.q} from={t.plan.from} when={t.plan.when}>
    <p>{t.plan.a}</p>
    <ol class="plan">{t.plan.steps.map((step, i) => <li class={i < t.plan.now ? 'done' : i === t.plan.now ? 'now' : undefined}>{step}{i === t.plan.now && <span class="pill">{t.plan.nowLbl}</span>}</li>)}</ol>
  </Letter>

  <section class="finale screen" id="finale">
    <div class="oz" aria-hidden="true"><span id="ozw">{t.inbox}</span><span class="n" id="ozn">{n}</span></div>
    <div class="bulk" id="bulk"><div class="under" aria-hidden="true"><svg width="18" height="18"><use href="#i-check"/></svg><span>{t.doneLbl}</span></div><button type="button" class="bs" id="bulkBtn"><span class="grip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span><span id="bulkText">{plural(lang, c.bulk, n)}</span><span class="grip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span></button></div>
    <p class="calm" id="calm" tabindex="-1" hidden>{t.calm}</p>
    <button type="button" class="back" id="bringBack" hidden>{t.bringBack}</button>
    {!released && <a class="next" href="#wait">{t.next}<span class="drift" aria-hidden="true">↓</span></a>}
  </section>

  {!released && (
    <section class="wait screen" id="wait" aria-labelledby="waitTitle">
      <p class="soon">{t.soon}</p>
      <div class="compose">
        <div class="field"><span class="lbl">{t.fTo}</span><span>{t.name}</span></div>
        <fieldset class="field"><legend class="lbl">{t.fPhone}</legend>
          <div class="seg">
            <label><input type="radio" name="os" value="android" checked><span>Android</span></label>
            <label><input type="radio" name="os" value="iphone"><span>iPhone</span></label>
          </div>
        </fieldset>
        <div class="field"><span class="lbl">{t.fSubj}</span><h2 id="waitTitle">{t.mailSubj}</h2></div>
        <p class="text">{t.mailBody}</p>
        <div class="send"><span class="fine">{t.cFine}</span><a class="btn" id="send" href={mailto('Android')} data-iphone={mailto('iPhone')} data-android={mailto('Android')}>{t.send}</a></div>
      </div>
    </section>
  )}

  <footer>
    <span><span>{t.by}</span> · <a href="https://khizrim.ru" target="_blank" rel="noopener">khizrim.ru</a></span>
    {STATS_URL && <span><span>{t.statsText}</span> <a href={STATS_URL} target="_blank" rel="noopener">{t.statsLink}</a></span>}
    {tip && <a href={tip} target="_blank" rel="noopener">{t.tipFoot}</a>}
  </footer>
</main>

<nav class="bbar" aria-label={t.barLabel}>
  <div class="cap">
    <div class="prog"><b id="left">{plural(lang, c.left, n)}</b><span class="track" role="progressbar" aria-valuemin="0" aria-valuemax={n} aria-valuenow="0" id="track" aria-label={t.progLabel}><i id="bar"></i></span></div>
    {!released && <a class="btn" href="#wait">{t.cta}</a>}
  </div>
</nav>
<p class="sr" id="live" aria-live="polite"></p>
<div class="toast" id="toast" hidden><span>{t.doneLbl}</span><button type="button" id="toastUndo">{t.undo}</button></div>

<script type="application/json" id="strings" set:html={JSON.stringify({ lang, word: t.inbox, done: t.doneLbl, ...c }).replace(/</g, '\\u003c')} />
<script>
  import { start } from '../../scripts/inbox';
  start();
</script>
</body>
</html>
