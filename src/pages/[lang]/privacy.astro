---
// The privacy policy: what the app and the site do with data. Plain text, one column.
import '../../styles/fonts.css';
import '../../styles/site.css';
import { LANGS, strings, type Lang } from '../../i18n';
import { fill } from '../../i18n/format';
import { CONTACT, INDEXABLE } from '../../config';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const p = strings[lang].privacy;
const site = Astro.site;
const [before, after] = p.sections.at(-1)!.p[0].split('{email}');
const sections = p.sections.slice(0, -1);
const contact = p.sections.at(-1)!;
---
<!doctype html>
<html lang={lang} class="doc">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{p.title}</title>
  <meta name="description" content={p.lead}>
  {!INDEXABLE && <meta name="robots" content="noindex, nofollow">}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/privacy/`, site)}>)}
  <meta name="color-scheme" content="light dark">
</head>
<body>
<main class="policy">
  <p class="home"><a href={`/${lang}/`}>{p.home}</a></p>
  <h1>{p.h1}</h1>
  <p class="date">{p.updated}</p>
  <p class="lead">{p.lead}</p>
  {sections.map((s) => (
    <section>
      <h2>{s.h}</h2>
      {s.p.map((text) => <p>{text}</p>)}
    </section>
  ))}
  <section>
    <h2>{contact.h}</h2>
    <p>{before}<a href={`mailto:${CONTACT}`}>{CONTACT}</a>{after}</p>
  </section>
  <p class="other">{LANGS.filter((l) => l !== lang).map((l) => <a href={`/${l}/privacy/`} lang={l}>{strings[l].privacy.h1}</a>)}</p>
</main>
</body>
</html>
