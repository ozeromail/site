---
// The app's dock at the foot of the list: tabs above (passed in), then accounts, search and a new message, all on glass.
interface Props {
  search: string;
}
const { search } = Astro.props;
---
<div class="bar">
  <slot />
  <p class="dock" aria-hidden="true">
    <span class="acc"><i class="a1"></i><i class="a2"></i><i class="a3"></i></span>
    <span class="find"><svg><use href="#i-search"/></svg>{search}</span>
    <span class="new"><svg><use href="#i-compose"/></svg></span>
  </p>
</div>
