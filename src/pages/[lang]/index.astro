---
// The page is a short inbox: three letters, one per pain. Clearing them leads to "ozero" and a note to the author.
import '../../styles/fonts.css';
import '../../styles/site.css';
import Mark from '../../components/Mark.astro';
import Letter from '../../components/Letter.astro';
import { LANGS, strings, type Lang } from '../../i18n';
import { plural } from '../../i18n/format';
import { CONTACT, INDEXABLE, STATS_URL, STORES, TIPS } from '../../config';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = strings[lang];
const c = t.client;
const tip = TIPS[lang];
const when = ['09:41', '09:38', t.tYest];
const letters = t.pains.map((p, i) => ({ id: `m${i + 1}`, tag: t.tags[i], when: when[i], subject: p.q, body: p.a }));
const n = letters.length;
const mailto = `mailto:${CONTACT}?subject=${encodeURIComponent(t.mailSubj)}&body=${encodeURIComponent(t.mailBody)}`;

const stores = [
  { key: 'appStore', url: STORES.appStore, small: t.storeApple, big: 'App Store' },
  { key: 'googlePlay', url: STORES.googlePlay, small: t.storeGoogle, big: 'Google Play' },
].filter((s) => s.url);

const shot = [
  { c: 'var(--acc-2)', who: t.sh1w, acc: t.aWork, when: '14:05', subj: t.sh1s, unread: true },
  { c: 'var(--acc-4)', who: t.sh2w, acc: t.aStudio, when: '13:18', subj: t.sh2s, unread: true },
  { c: 'var(--acc-3)', who: t.sh3w, acc: 'iCloud', when: '11:30', subj: t.sh3s },
  { c: 'var(--acc-1)', who: t.sh4w, acc: t.aPersonal, when: t.tYest, subj: t.sh4s },
];
const site = Astro.site;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{t.title}</title>
  <meta name="description" content={t.description}>
  {!INDEXABLE && <meta name="robots" content="noindex, nofollow">}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, site)}>)}
  <link rel="alternate" hreflang="x-default" href={new URL('/en/', site)}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Ozero Mail">
  <meta property="og:title" content={t.h1}>
  <meta property="og:description" content={t.sub}>
  <meta property="og:url" content={new URL(`/${lang}/`, site)}>
  <meta property="og:locale" content={t.ogLocale}>
  <meta property="og:image" content={new URL(`/og-${lang}.png`, site)}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="color-scheme" content="light dark">
  <noscript><style>.tip,.mfoot{display:none}</style></noscript>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</svg>

<div class="lake" id="lake" aria-hidden="true"><i></i><i></i><i></i></div>
<main id="app">
  <header class="top">
    <span class="brand"><Mark id="mk" />ozero mail</span>
    <nav class="lang" aria-label={t.langLabel}>
      {LANGS.map((l) => <a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>)}
    </nav>
  </header>

  <section class="head">
    <p class="inboxline"><span>{t.inbox}</span><span class="n" id="count">{n}</span><span class="sr" id="unreadSr"> {plural(lang, c.unread, n)}</span></p>
    <h1>{t.h1}</h1>
    <p class="sub">{t.sub}</p>
    {stores.length > 0 && (
      <div class="stores">{stores.map((s) => <a class="store" href={s.url} target="_blank" rel="noopener"><small>{s.small}</small><b>{s.big}</b></a>)}</div>
    )}
    <p class="tip">{t.tip}</p>
  </section>

  {letters.map((l, i) => (
    <Letter t={t} {...l}>
      <Fragment slot="from">{i === 0 ? <>{t.name}<span class="role">{t.role}</span></> : l.tag}</Fragment>
      <div class="mbody">
        <p>{l.body}</p>
        {i === 0 && (
          <div class="shot" role="img" aria-label={t.shotLabel}>
            <div class="top-s"><strong>{t.inbox}</strong><span>{t.shAll}</span></div>
            {shot.map((r) => (
              <div class:list={['r', { u: r.unread }]} style={`--rc:${r.c}`}><div class="l1"><b>{r.who}</b><small>{r.acc}</small><small>{r.when}</small></div><div class="s">{r.subj}</div></div>
            ))}
            <div class="tabs"><span class="on">{t.tbPeople}</span><span>{t.tbServices}</span><span>{t.tbNews}</span></div>
          </div>
        )}
      </div>
    </Letter>
  ))}

  <section class="finale" id="finale">
    <div class="oz" aria-hidden="true"><span class="w" id="ozw">{c.word}</span><span class="n" id="ozn">{n}</span></div>
    <p class="calm" id="calm" tabindex="-1" hidden>{t.calm}</p>
    <p class="soon">{t.soon}</p>
    <a class="btn" href={mailto}>{t.write}</a>
  </section>

  <footer>
    <span><span>{t.by}</span> · <a href="https://khizrim.ru" target="_blank" rel="noopener">khizrim.ru</a></span>
    {STATS_URL && <span><span>{t.statsText}</span> <a href={STATS_URL} target="_blank" rel="noopener">{t.statsLink}</a></span>}
    {tip && <a href={tip} target="_blank" rel="noopener">{t.tipFoot}</a>}
  </footer>
</main>

<p class="sr" id="live" aria-live="polite"></p>
<div class="toast" id="toast" hidden><span id="toastText"></span><button type="button" id="toastUndo">{t.undo}</button></div>

<script type="application/json" id="strings" set:html={JSON.stringify({ lang, ...c }).replace(/</g, '\\u003c')} />
<script>
  import { start } from '../../scripts/inbox';
  start();
</script>
</body>
</html>
