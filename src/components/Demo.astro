---
// A small live piece of the app inside a letter, so the point is seen, not only read. It moves only when touched.
import type { Strings } from '../i18n';
import { fill } from '../i18n/format';
import Row from './Row.astro';

interface Props {
  t: Strings;
  kind?: string;
}
const { t, kind } = Astro.props;
const d = t.demo;
---
{kind === 'zero' && (
  <div class="demo zero">
    <p class="dh">{d.zero.title}<span class="dc">{d.zero.rows.length}</span></p>
    <div class="dl">
      {d.zero.rows.map(([who, what, when]) => (
        <div class="swipe">
          <div class="under" aria-hidden="true"><span class="word">{t.doneLbl}</span><span class="bead"><svg aria-hidden="true" width="18" height="18"><use href="#i-check"/></svg></span></div>
          <Row who={who} what={what} when={when} unread />
          <button type="button" class="rowdone" aria-label={fill(t.doneFor, { s: `${who}, ${what}` })}><svg aria-hidden="true"><use href="#i-check"/></svg></button>
        </div>
      ))}
      <div class="de">
        <canvas aria-hidden="true"></canvas>
        <p class="det">{d.zero.empty}</p>
        <p class="des">{d.zero.emptyText}</p>
        <button type="button" class="deb">{d.zero.back}</button>
      </div>
    </div>
  </div>
)}
{kind === 'boxes' && (
  <div class="demo boxes">
    <div class="tabs" role="radiogroup" aria-label={d.boxes.label}>
      {d.boxes.modes.map((mode, i) => <label><input type="radio" name="boxes" value={i} checked={i === 0} /><span>{mode}</span></label>)}
    </div>
    <div class="sheetish" aria-hidden="true">
      <p class="dh">{d.boxes.title}</p>
      <p class="bx inbox"><span class="dots"><i></i><i></i><i></i></span><span class="bn">{d.boxes.folders[0]}</span><span class="bc">12</span></p>
      <p class="cap">{d.boxes.caption}</p>
      {d.boxes.merged.map((all, i) => (
        <div class="grp">
          {d.boxes.accounts.map((a, j) => <p class="bx one"><svg aria-hidden="true" class="ic"><use href={i ? '#i-archive' : '#i-sent'}/></svg><span class="bn">{d.boxes.folders[i + 1]}</span><span class="ds">{a}</span><i class={`dot a${j + 1}`}></i></p>)}
          <p class="bx all"><svg aria-hidden="true" class="ic"><use href={i ? '#i-archive' : '#i-sent'}/></svg><span class="bn">{all}</span></p>
        </div>
      ))}
    </div>
  </div>
)}
{kind === 'privacy' && (
  <div class="demo privacy">
    <Row who={d.privacy.from} what={d.privacy.subj} when="08:00" />
    <label class="pic">
      <input type="checkbox" aria-label={d.privacy.showLabel} />
      <span class="bar"><span>{d.privacy.hidden}</span><span class="btnish">{d.privacy.show}</span></span>
      <span class="img" aria-hidden="true"></span>
    </label>
  </div>
)}
{kind === 'focus' && (
  <div class="demo focus">
    <div class="tabs" role="radiogroup" aria-label={d.focus.label}>
      {d.focus.tabs.map((tab, i) => <label><input type="radio" name="focus" value={i} checked={i === 0} /><span>{tab}<b class="n">{d.focus.lists[i].length}</b></span></label>)}
    </div>
    <div class="dl">
      {d.focus.lists.map((list, i) => <div class={`fl f${i}`}>{list.map(([who, what, when], j) => <Row who={who} what={what} when={when} unread={j === 0} />)}</div>)}
    </div>
  </div>
)}
{kind === 'work' && (
  <div class="demo work">
    <div class="card">
      <p class="wt">{d.work.title}</p>
      <p class="ws">{d.work.time}</p>
      <p class="ws">{d.work.place}</p>
      <div class="day" aria-hidden="true">
        <p class="dayh">{d.work.day}<span>{d.work.fromMail}</span></p>
        <div class="hours">
          {['13', '14', '15'].map((h) => <span class="h">{h}</span>)}
          <span class="ev this">{d.work.title}</span>
          <span class="ev other">{d.work.other}</span>
        </div>
      </div>
      <div class="answers">
        {d.work.answers.map((a, i) => <button type="button" class={i === 2 ? 'yes' : undefined} data-result={d.work.results[i]}>{a}</button>)}
      </div>
      <p class="result"><span class="rtext" role="status"></span><button type="button" class="chg">{d.work.change}</button></p>
    </div>
  </div>
)}
