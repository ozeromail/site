---
// One section of the page, shaped as a letter: swipe it left or press Done to collapse it.
import type { Strings } from '../i18n';
import { fill } from '../i18n/format';

interface Props {
  t: Strings;
  id?: string;
  subject: string;
  from: string;
  when: string;
}
const { t, id, subject, from, when } = Astro.props;
---
<article class="mail screen" id={id} tabindex="-1">
  <div class="under" aria-hidden="true"><span class="word">{t.doneLbl}</span><span class="bead"><svg aria-hidden="true" width="20" height="20"><use href="#i-check"/></svg></span></div>
  <div class="sheet">
    <h2 class="subj">{subject}</h2>
    <div class="mhead"><span class="from">{from}</span><span class="when">{when}</span></div>
    <slot />
    <button class="act done" type="button" aria-label={fill(t.doneFor, { s: subject })}><svg aria-hidden="true"><use href="#i-check"/></svg><span>{t.doneLbl}</span></button>
  </div>
  <button class="row" type="button" aria-label={fill(t.openFor, { s: subject })}><span class="ok"><svg aria-hidden="true" width="16" height="16"><use href="#i-check"/></svg></span><span class="rs">{subject}</span><span class="open">{t.reopen}</span></button>
</article>
