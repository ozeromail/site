---
// The page is a short inbox: a letter per pain, then one from the author, with plenty of air. Clearing them leads to "ozero" and a note to the author.
import '../../styles/fonts.css';
import '../../styles/site.css';
import Mark from '../../components/Mark.astro';
import Part from '../../components/Part.astro';
import Demo from '../../components/Demo.astro';
import { LANGS, strings, type Lang } from '../../i18n';
import { fill } from '../../i18n/format';
import { CONTACT, INDEXABLE, STATS_URL, STORES, TIPS } from '../../config';
import interLatin from '@fontsource-variable/inter/files/inter-latin-standard-normal.woff2?url';
import interCyrillic from '@fontsource-variable/inter/files/inter-cyrillic-standard-normal.woff2?url';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = strings[lang];
const tip = TIPS[lang];
const mailto = (os: string) =>
  `mailto:${CONTACT}?subject=${encodeURIComponent(t.mailSubj)}&body=${encodeURIComponent(`${t.mailBody}\n\n${fill(t.cPhone, { os })}`)}`;

const stores = [
  { key: 'appStore', url: STORES.appStore, small: t.storeApple, big: 'App Store' },
  { key: 'googlePlay', url: STORES.googlePlay, small: t.storeGoogle, big: 'Google Play' },
].filter((s) => s.url);
const released = stores.length > 0;

const site = Astro.site;
const url = new URL(`/${lang}/`, site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{t.title}</title>
  <meta name="description" content={t.description}>
  {!INDEXABLE && <meta name="robots" content="noindex, nofollow">}
  {(lang === 'ru' ? [interLatin, interCyrillic] : [interLatin]).map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin>)}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, site)}>)}
  <link rel="alternate" hreflang="x-default" href={new URL('/en/', site)}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Ozero Mail">
  <meta property="og:title" content={t.h1}>
  <meta property="og:description" content={t.sub}>
  <meta property="og:url" content={url}>
  <meta property="og:locale" content={t.ogLocale}>
  <meta property="og:image" content={new URL(`/og-${lang}.png`, site)}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="color-scheme" content="light dark">
  <noscript><style>.finale .calm,.finale .next{opacity:1}</style></noscript>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-sent" viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-archive" viewBox="0 0 24 24"><path d="M3 5h18v4H3zM5 9v10h14V9M10 13h4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11zM12 12.2a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></symbol>
  <symbol id="i-maybe" viewBox="0 0 24 24"><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-0.6 0.3-1 0.9-1 1.6V14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M10.8 17.5a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0-2.4 0z" fill="currentColor"/></symbol>
  <symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/></symbol>
  <symbol id="i-video" viewBox="0 0 24 24"><path d="M5 7h8a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2zM15 11l6-3v8l-6-3" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></symbol>
  <symbol id="i-spam" viewBox="0 0 24 24"><path d="M8.5 3h7L21 8.5v7L15.5 21h-7L3 15.5v-7zM12 8v5M12 16.2v.3" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4.5h6V7M6 7l1 13h10l1-13" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</svg>

<main id="app">
  <header class="top">
    <span class="brand"><Mark id="mk" />ozero mail</span>
    <nav class="lang" aria-label={t.langLabel}>
      {LANGS.map((l) => <a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>)}
    </nav>
  </header>

  <section class="head screen">
    <h1>{t.h1}</h1>
    <p class="sub">{t.sub}</p>
    {released && (
      <div class="stores">{stores.map((s) => <a class="store" href={s.url} target="_blank" rel="noopener"><small>{s.small}</small><b>{s.big}</b></a>)}</div>
    )}
    <a class="tip" href="#first">{t.more}<span class="drift" aria-hidden="true">↓</span></a>
  </section>

  {t.pains.map((p, i) => (
    <Part id={i === 0 ? 'first' : undefined} title={p.q}><p>{p.a}</p><Demo t={t} kind={p.demo} /></Part>
  ))}
  <Part title={t.plan.q}>
    <p>{t.plan.a}</p>
    <ol class="plan">{t.plan.steps.map((step, i) => <li class={i < t.plan.now ? 'done' : i === t.plan.now ? 'now' : undefined} aria-current={i === t.plan.now ? 'step' : undefined}>{step}{i < t.plan.now && <span class="sr">, {t.plan.doneLbl}</span>}{i === t.plan.now && <> <span class="pill">{t.plan.nowLbl}</span></>}</li>)}</ol>
  </Part>

  <section class="finale screen" id="finale">
    <div class="oz" aria-hidden="true">{t.ozero}</div>
    <canvas class="lake" id="lake" aria-hidden="true"></canvas>
    <p class="calm">{t.calm}</p>
    {!released && <a class="next" href="#wait">{t.next}<span class="drift" aria-hidden="true">↓</span></a>}
  </section>

  {!released && (
    <section class="wait screen" id="wait" aria-labelledby="waitTitle">
      <p class="soon">{t.soon}</p>
      <div class="compose">
        <div class="field"><span class="lbl">{t.fTo}</span><span>{t.name}</span></div>
        <div class="field"><span class="lbl" id="osLbl">{t.fOs}</span>
          <div class="seg" role="radiogroup" aria-labelledby="osLbl">
            <label><input type="radio" name="os" value="android" checked><span>Android</span></label>
            <label><input type="radio" name="os" value="iphone"><span>iPhone</span></label>
          </div>
        </div>
        <div class="field"><span class="lbl">{t.fSubj}</span><h2 id="waitTitle">{t.mailSubj}</h2></div>
        <p class="text">{t.mailBody}</p>
        <div class="send"><span class="fine">{t.cFine}</span><a class="btn" id="send" href={mailto('Android')} data-iphone={mailto('iPhone')} data-android={mailto('Android')}>{t.send}</a></div>
      </div>
    </section>
  )}

  <footer>
    <span><span>{t.by}</span> · <a href="https://khizrim.ru" target="_blank" rel="noopener">khizrim.ru</a></span>
    {STATS_URL && <span><span>{t.statsText}</span> <a href={STATS_URL} target="_blank" rel="noopener">{t.statsLink}</a></span>}
    {tip && <a href={tip} target="_blank" rel="noopener">{t.tipFoot}</a>}
    <a href={`/${lang}/privacy/`}>{t.privacyLink}</a>
  </footer>
</main>

{!released && <nav class="bbar" aria-label={t.barLabel}><a class="btn" href="#wait">{t.cta}</a></nav>}
<script>
  import { start } from '../../scripts/inbox';
  start();
</script>
</body>
</html>
