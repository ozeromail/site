---
// A small live piece of the app inside a part, so the point is seen, not only read. It moves only when touched.
import type { Strings } from '../i18n';
import { fill } from '../i18n/format';
import Row from './Row.astro';
import Under from './Under.astro';

interface Props {
  t: Strings;
  kind?: string;
}
const { t, kind } = Astro.props;
const d = t.demo;
const icons = ['#i-sent', '#i-archive', '#i-spam', '#i-trash'];
---
{kind === 'zero' && (
  <div class="demo zero">
    <p class="dh">{d.zero.title}<span class="dc">{d.zero.rows.length}</span></p>
    <div class="dl">
      {d.zero.rows.map(([who, what, when]) => (
        <div class="swipe">
          <Under label={t.doneLbl} />
          <Row who={who} what={what} when={when} unread />
          <button type="button" class="rowdone" aria-label={fill(t.doneFor, { s: `${who}, ${what}` })}><svg aria-hidden="true"><use href="#i-check"/></svg></button>
        </div>
      ))}
      <div class="de">
        <canvas aria-hidden="true"></canvas>
        <p class="det">{d.zero.empty}</p>
        <p class="des">{d.zero.emptyText}</p>
        <button type="button" class="deb">{d.zero.back}</button>
      </div>
    </div>
  </div>
)}
{kind === 'boxes' && (
  <div class="demo boxes">
    <div class="tabs" role="radiogroup" aria-label={d.boxes.label}>
      {d.boxes.modes.map((mode, i) => <label><input type="radio" name="boxes" value={i} checked={i === 0} /><span>{mode}</span></label>)}
    </div>
    <div class="sheetish" aria-hidden="true">
      <p class="dh">{d.boxes.title}</p>
      <p class="bx inbox"><span class="dots"><i></i><i></i><i></i></span><span class="bn">{d.boxes.folders[0]}</span><span class="bc">12</span></p>
      <div class="views">
        <div class="v v0">
          {[0, 1].map((i) => d.boxes.accounts.map((a, j) => <p class:list={['bx', { head: j === 0 }]} style={`--d:${-(i * (d.boxes.accounts.length - 1) + j)}`}><svg aria-hidden="true" class="ic"><use href={icons[i]}/></svg><span class="bn">{d.boxes.folders[i + 1]}</span><span class="ds">{a}</span><i class={`dot a${j + 1}`}></i></p>))}
        </div>
        <div class="v v1">
          {d.boxes.merged.map((all, i) => <p class:list={['bx', { more: i > 1 }]} style={`--k:${i}`}><svg aria-hidden="true" class="ic"><use href={icons[i]}/></svg><span class="bn">{all}</span><span class="trio">{d.boxes.accounts.map((_, j) => <i class={`dot a${j + 1}`}></i>)}</span></p>)}
          <p class="cap">{d.boxes.caption}</p>
          <p class="bx accs">{d.boxes.accounts.map((a, j) => <span><i class={`dot a${j + 1}`}></i>{a}</span>)}</p>
        </div>
      </div>
    </div>
  </div>
)}
{kind === 'privacy' && (
  <div class="demo privacy">
    <div class="lh"><p class="ls">{d.privacy.subj}</p><p class="lf"><b>{d.privacy.from}</b><span>08:00</span></p></div>
    <label class="pic">
      <input type="checkbox" aria-label={d.privacy.showLabel} />
      <span class="bar"><span>{d.privacy.hidden}</span><span class="btnish">{d.privacy.show}</span></span>
      <span class="img" aria-hidden="true"></span>
    </label>
  </div>
)}
{kind === 'focus' && (
  <div class="demo focus">
    <div class="tabs" role="radiogroup" aria-label={d.focus.label}>
      {d.focus.tabs.map((tab, i) => <label><input type="radio" name="focus" value={i} checked={i === 0} /><span><span class="tl">{tab}</span>{i === 0 && <b class="n">1</b>}</span></label>)}
    </div>
    <div class="dl">
      {d.focus.lists.map((list, i) => <div class={`fl f${i}`}>{list.map(([who, what, when], j) => <Row who={who} what={what} when={when} unread={i === 0 && j === 0} />)}</div>)}
    </div>
  </div>
)}
{kind === 'work' && (
  <div class="demo work">
    <div class="card">
      <p class="wt">{d.work.title}</p>
      <p class="ws">{d.work.time}</p>
      <p class="ws">{d.work.place} · <span class="join">{d.work.join}</span></p>
      <div class="day" aria-hidden="true">
        <p class="track"><i class="o" style="--a:1;--b:2"></i><i class="me" style="--a:5;--b:5.5"></i><i class="x" style="--a:5.5;--b:6"></i><i class="o" style="--a:6;--b:6.5"></i></p>
        <p class="hrs"><span>9</span><span>12</span><span>15</span><span>18</span></p>
      </div>
      <p class="clash">{d.work.clash}</p>
      <div class="reply">
      <div class="answers" role="group" aria-label={d.work.label}>
        {d.work.answers.map((a, i) => <button type="button" class={i === 2 ? 'yes' : undefined} data-answer={i} data-result={d.work.results[i]}>{a}</button>)}
      </div>
      <p class="result"><span class="rs">{['#i-close', '#i-maybe', '#i-check'].map((i, n) => <svg aria-hidden="true" class={`ri r${n}`}><use href={i}/></svg>)}<span class="rtext" role="status"></span></span><button type="button" class="chg">{d.work.change}</button></p>
      </div>
    </div>
  </div>
)}
{kind === 'hand' && (
  <div class="demo hand">
    <div class="tabs" role="radiogroup" aria-label={d.hand.label}>
      {d.hand.modes.map((mode, i) => <label><input type="radio" name="hand" value={i} checked={i === 0} /><span>{mode}</span></label>)}
    </div>
    <div class="screen" aria-hidden="true">
      <div class="v v0">
        <p class="ht">{d.hand.title}</p>
        <div class="hl">{d.zero.rows.slice(0, 2).map(([who, what, when], i) => <Row who={who} what={what} when={when} unread={i === 0} />)}</div>
        <p class="dock">
          <span class="dots"><i></i><i></i><i></i></span>
          <svg><use href="#i-search"/></svg>
          <svg><use href="#i-compose"/></svg>
        </p>
      </div>
      <div class="v v1">
        <p class="quote">{d.zero.rows[0][0]} · {d.zero.rows[0][1]}</p>
        <div class="page">
          <p class="hf"><span>{d.hand.to}</span>{d.zero.rows[0][0]}</p>
          <p class="hf"><span>{d.hand.subj}</span>Re: {d.zero.rows[0][1]}</p>
          <p class="hb">{d.hand.body}<i class="caret"></i></p>
        </div>
        <p class="keys"><i></i><i></i><i></i></p>
      </div>
    </div>
  </div>
)}
