---
// What a swipe reveals: the action's word and its bead by the edge.
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<div class="under" aria-hidden="true"><span class="word">{label}</span><span class="bead"><svg width="18" height="18"><use href="#i-check"/></svg></span></div>
